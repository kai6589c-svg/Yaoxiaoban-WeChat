.sync-page {
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
}
.hint,
.message {
  margin: 20rpx 0;
  line-height: 1.6;
  color: #52665d;
}
.card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}
.name {
  font-size: 34rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.card button {
  margin-top: 16rpx;
  min-height: 88rpx;
  font-size: 30rpx;
}
.empty {
  padding: 72rpx 0;
  text-align: center;
}
.notice {
  padding: 24rpx;
  background: #fff4dc;
}

.page {
  font-size: calc(28rpx * var(--text-scale, 1));
}
.card button {
  min-height: 44px;
  padding: 16rpx;
  font-size: inherit;
}
